# Copy to .env (gitignored) and fill in. Only the provider you use needs a key.

# Default provider: Gemini — key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Fallback provider: OpenRouter — key from https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=<model slug from https://openrouter.ai/models>
